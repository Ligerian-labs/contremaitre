{
  "name": "contremaitre",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "bun run lint && bun run check:boundaries && bun run typecheck && bun test && bun run build && bun run test:packaging",
    "lint": "biome check apps packages test scripts",
    "format": "biome check --write apps packages test scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build apps/cli/src/cli.ts --compile --target=bun-darwin-arm64 --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile bin/contremaitre",
    "test:packaging": "bun scripts/verify-packaging.ts",
    "check:boundaries": "bun scripts/verify-boundaries.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3",
    "@contremaitre/cli": "workspace:*",
    "@contremaitre/execution": "workspace:*",
    "@contremaitre/projects": "workspace:*",
    "@contremaitre/environments": "workspace:*",
    "@contremaitre/operations": "workspace:*",
    "@contremaitre/routing": "workspace:*",
    "@contremaitre/hub": "workspace:*",
    "effect": "3.22.1",
    "@effect/platform-bun": "0.91.2",
    "@structure-ai/cli": "0.1.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
